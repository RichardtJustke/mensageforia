# ============================================================
# MensageForia — variáveis de ambiente
#
# Como usar:
#   cp .env.example .env   # depois preencha os valores
#
# - O docker compose lê o .env automaticamente.
# - O .env NÃO vai para o git (já está no .gitignore).
# ============================================================

# ------------------------------------------------------------
# OBRIGATÓRIA
# ------------------------------------------------------------

# Personal Access Token do GitHub (fine-grained), com acesso ao
# repositório mensageforia e permissão:
#   Repository permissions > Contents > Read and write
#
# Criar em: GitHub > Settings > Developer settings >
#           Personal access tokens > Fine-grained tokens
GITHUB_TOKEN=github_pat_COLE_SEU_TOKEN_AQUI

# ------------------------------------------------------------
# OPCIONAIS (têm defaults no código / docker-compose.yml)
# ------------------------------------------------------------

# Modelo do Ollama que gera as mensagens
OLLAMA_MODEL=llama3.2:1b

# Endereço do servidor Ollama (default no compose: http://ollama:11434)
# OLLAMA_BASE_URL=http://ollama:11434

# Fuso horário do agendador (default: America/Sao_Paulo)
# TZ=America/Sao_Paulo

# Autor dos commits automáticos
# GIT_AUTHOR_NAME=MensageForia Bot
# GIT_AUTHOR_EMAIL=bot@mensageforia.local

# Janela de horários para as mensagens (default: 08:00 às 20:00)
# Às 01:00 o sistema sorteia 1–10 mensagens e distribui nessa janela.
# MSG_WINDOW_START=08:00
# MSG_WINDOW_END=20:00
